# 复制为 .env 后填入实际值。.env 不进版本控制。
# compose.yml 会自动读取同目录的 .env。

# 数据库（POSTGRES_PASSWORD 建议改掉；仅容器内网 + 绑定 127.0.0.1，不出公网）
POSTGRES_USER=wee
POSTGRES_PASSWORD=change-me
# 密码只允许 URL 安全字符：compose 会把它直接拼进 DATABASE_URL（postgres://user:pass@host/db），
# 密码里的 @ : / # 会让连接串不合法，$ 会被 compose 当变量插值吃掉（需写 $$ 转义）。
# 最省事：只用字母数字、- 和 _。
POSTGRES_DB=wee-cook

# Redis
REDIS_PASSWORD=change-me

# JWT 签名密钥：随机长字符串（必填）
JWT_SECRET=change-me-in-production

# 反向代理信任：仅当服务位于可信反向代理（如 Caddy）之后时设为 true，
# 否则限流按 socket peer 地址计（默认，客户端无法伪造 X-Forwarded-For 绕过）。
TRUST_PROXY=false

# 跨域白名单：逗号分隔、必须带 scheme、精确匹配。
# ⚠️ 设置了就**整体替换**默认值（不是追加）。Tauri 壳（含安卓实机）发出的请求
# Origin 是 http://tauri.localhost；桌面 `npm run tauri dev` 走 Vite 开发服务器，
# Origin 是 http://localhost:1420。线上换成你真实的前端来源，不要照抄开发值。
CORS_ALLOWED_ORIGINS=http://tauri.localhost,http://localhost:1420
