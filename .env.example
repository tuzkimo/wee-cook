# 复制为 .env 后填入实际值。.env 不进版本控制。
# compose.yml 会自动读取同目录的 .env。

# 数据库（POSTGRES_PASSWORD 建议改掉；仅容器内网 + 绑定 127.0.0.1，不出公网）
POSTGRES_USER=wee
POSTGRES_PASSWORD=change-me
# ⚠️ 这个值只在**首次** up（数据卷还是空的）时生效。Postgres 只在空数据目录上初始化密码，
#    之后再改它不会生效，会以「password authentication failed」的形式报出来。
#    要改：`docker compose down -v` 删卷重建（会删库与图片），或把这里改回旧值。
#    不填本项时 compose 回退到 `wee`（见 docs/SELF-HOSTING.md 的环境变量表）。
# 密码只允许 URL 安全字符：compose 会把它直接拼进 DATABASE_URL（postgres://user:pass@host/db），
# 密码里的 @ : / # 会让连接串不合法，$ 会被 compose 当变量插值吃掉（需写 $$ 转义）。
# 最省事：只用字母数字、- 和 _。
POSTGRES_DB=wee-cook

# Redis
REDIS_PASSWORD=change-me

# JWT 签名密钥：随机长字符串（必填）
JWT_SECRET=change-me-in-production

# 反向代理信任：仅当服务位于可信反向代理（如 Caddy）之后时设为 true，
# 否则限流按 socket peer 地址计（默认，客户端无法伪造 X-Forwarded-For 绕过）。
TRUST_PROXY=false

# 跨域白名单：逗号分隔、必须带 scheme、精确匹配。
# ⚠️ 设置了就**整体替换**默认值（不是追加）。Tauri 壳（含安卓实机）发出的请求
# Origin 是 http://tauri.localhost；桌面 `npm run tauri dev` 走 Vite 开发服务器，
# Origin 是 http://localhost:1420。线上换成你真实的前端来源，不要照抄开发值。
CORS_ALLOWED_ORIGINS=http://tauri.localhost,http://localhost:1420

# ===== AI 菜谱助手（可选）=====
# 不填 AI_API_KEY 时整条 AI 管道关闭，服务照常启动（不阻塞）。
# 填了还要在 App「我的 → AI 菜谱助手」里打开 AI 开关，入口才会出现。
AI_API_KEY=
# 上游接口地址，只支持 OpenAI 兼容的 /chat/completions 协议。
AI_BASE_URL=https://api.deepseek.com/v1
# 模型必须同时支持 tool calls 与 image_url 图片输入。
# deepseek-flash（V4.1-Flash）两者都支持；deepseek-chat 不支持图片。
AI_MODEL=deepseek-flash
# 单次回复的最大 token 数
AI_MAX_TOKENS=1024
# 等待上游回复的超时；长截图视觉推理较慢，不要调小
AI_TIMEOUT=120s
# 每个用户每分钟最多请求次数
AI_RATE_LIMIT=20
# 每个用户每天最多请求次数
AI_DAILY_LIMIT=200
# 上游需要经代理访问时填（容器出网代理）；留空 = 直连。
# 这三个键只对 compose 启动的容器生效（映射成容器内的 HTTP_PROXY/HTTPS_PROXY/NO_PROXY）。
# 本地直跑后端（不经 compose）时，改在 shell 里设 HTTPS_PROXY/NO_PROXY。
# 容器要访问宿主机上的代理：Docker Desktop 用 http://host.docker.internal:7890，Linux 填网关地址。
AI_HTTP_PROXY=
AI_HTTPS_PROXY=
AI_NO_PROXY=localhost,127.0.0.1,postgres,redis
